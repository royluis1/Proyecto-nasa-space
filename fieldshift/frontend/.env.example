# URL del backend de FieldShift (FastAPI). Sin barra final.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
# Si el backend no responde, mostrar datos de ejemplo (con aviso). "false" para desactivarlo.
NEXT_PUBLIC_DEMO_FALLBACK=true

# Supabase (login e historial de lotes). Son PÚBLICAS: viajan al navegador.
# Supabase -> tu proyecto -> Settings -> API. Dejalas vacías para usar FieldShift sin login.
# NO pongas acá la contraseña de la base ni la service_role key (esas son secretas).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
