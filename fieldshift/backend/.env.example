# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# development | production
FIELDSHIFT_ENVIRONMENT=development
FIELDSHIFT_LOG_LEVEL=INFO

# NASA POWER (API pública, no requiere clave)
FIELDSHIFT_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
FIELDSHIFT_POWER_COMMUNITY=AG

# Red
FIELDSHIFT_REQUEST_TIMEOUT_S=30
FIELDSHIFT_MAX_RETRIES=3
FIELDSHIFT_RETRY_BACKOFF_S=1

# Caché (horas) para datos recientes; los históricos no vencen
# Vacío = carpeta data/cache del repo
FIELDSHIFT_CACHE_TTL_HOURS=24
FIELDSHIFT_CACHE_DIR=

# Catálogos JSON (vacío = backend/app/data)
FIELDSHIFT_SAMPLE_DATA_DIR=
# Datos NASA de muestra (vacío = data/samples del repo)
FIELDSHIFT_NASA_SAMPLES_DIR=

# Orígenes permitidos para el frontend (lista JSON)
FIELDSHIFT_CORS_ORIGINS=["http://localhost:3000"]

# Opcionales (dejar vacío si no se usan)
FIELDSHIFT_EARTHDATA_TOKEN=
FIELDSHIFT_LLM_ENABLED=false
FIELDSHIFT_LLM_API_KEY=
