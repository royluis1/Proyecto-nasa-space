# Copiar a .env y ajustar. Nunca subir .env al repositorio.

# development | production
FIELDSHIFT_ENVIRONMENT=development
FIELDSHIFT_LOG_LEVEL=INFO

# NASA POWER (API pública, no requiere clave)
FIELDSHIFT_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
FIELDSHIFT_POWER_COMMUNITY=AG

# Red
FIELDSHIFT_REQUEST_TIMEOUT_S=30
FIELDSHIFT_MAX_RETRIES=3
FIELDSHIFT_RETRY_BACKOFF_S=1

# Caché (horas) para datos recientes; los históricos no vencen
# Vacío = carpeta data/cache del repo
FIELDSHIFT_CACHE_TTL_HOURS=24
# Tras una falla de NASA POWER, segundos sin reintentar en vivo (se usa caché o muestra)
FIELDSHIFT_POWER_COOLDOWN_S=300
FIELDSHIFT_CACHE_DIR=

# Catálogos JSON (vacío = backend/app/data)
FIELDSHIFT_SAMPLE_DATA_DIR=
# Datos NASA de muestra (vacío = data/samples del repo)
FIELDSHIFT_NASA_SAMPLES_DIR=

# Orígenes permitidos para el frontend (lista JSON)
FIELDSHIFT_CORS_ORIGINS=["http://localhost:3000"]

# AppEEARS (SMAP y MODIS en vivo). Cuenta gratuita de NASA Earthdata.
# Con token, o con usuario y contraseña (la API pide el token). Vacío = solo CSV cargado, caché o muestra.
FIELDSHIFT_APPEEARS_TOKEN=
FIELDSHIFT_APPEEARS_USERNAME=
FIELDSHIFT_APPEEARS_PASSWORD=

# Opcionales (dejar vacío si no se usan)
# CSV reales de NASA POWER (en data/samples) usados si la API no responde, antes de la muestra simulada
FIELDSHIFT_POWER_FALLBACK_FILES=["power_campo1.csv"]

# Pronóstico Open-Meteo (no es NASA). Sin clave: uso no comercial. Con plan comercial, URL customer-api y clave.
FIELDSHIFT_OPEN_METEO_ENABLED=true
FIELDSHIFT_OPEN_METEO_URL=https://api.open-meteo.com/v1/forecast
FIELDSHIFT_OPEN_METEO_API_KEY=

# Earthdata Login (https://urs.earthdata.nasa.gov): descarga de SRTM (relieve). Usuario y contraseña, o token.
# Si quedan vacíos, se usan los de AppEEARS (es la misma cuenta). Sin ninguno: relieve de muestra simulada.
FIELDSHIFT_EARTHDATA_USERNAME=
FIELDSHIFT_EARTHDATA_PASSWORD=
FIELDSHIFT_EARTHDATA_TOKEN=
# SoilGrids (suelo estimado) tarda mucho y de forma variable: espera por consulta y pausa si falla (segundos)
FIELDSHIFT_SOILGRIDS_TIMEOUT_S=45
FIELDSHIFT_SOILGRIDS_COOLDOWN_S=60
# SRTMGL1 (30 m, ~25 MB por baldosa) o SRTMGL3 (90 m, ~3 MB)
FIELDSHIFT_SRTM_PRODUCT=SRTMGL1
FIELDSHIFT_LLM_ENABLED=false
FIELDSHIFT_LLM_API_KEY=
